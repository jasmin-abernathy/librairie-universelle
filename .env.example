APP_ENV=development
APP_NAME="Librairie universelle"

# Chemin absolu facultatif. Par défaut : data/app.sqlite
# DATABASE_PATH=/var/lib/librairie-universelle/app.sqlite

# Stockage privé hors webroot pour les fichiers soumis par les auteurs.
# STORAGE_PATH=/home/user/librairie-universelle-storage

# Les fonctionnalités d'écriture publiques restent fermées tant qu'elles ne sont pas explicitement activées.
SELF_PUBLISHING_ENABLED=false
FEEDBACK_ENABLED=false

# Obligatoire pour /admin/* en production. Utiliser une valeur longue et aléatoire.
ADMIN_TOKEN=

# Une offre plus ancienne que cette durée est affichée comme « à revérifier ».
OFFER_MAX_AGE_DAYS=7

# Pilote territorial facultatif. Laisser vide tant que librairie-moselle n'est pas déployé.
# Exemple : https://moselle.exemple.fr
MOSELLE_BASE_URL=

# Limites d'upload en octets.
MAX_EPUB_BYTES=52428800
MAX_PDF_BYTES=104857600
MAX_COVER_BYTES=15728640


# Atelier EPUB local-first. When set, the auto-publishing page offers a link
# to create/edit the EPUB before submitting it for human review.
ATELIER_EPUB_URL=

# Export professionnel PDF/X-4 ou PDF/X-1a:2001 : fermé par défaut.
# Exécuter Ghostscript via un worker isolé avant d'autoriser les uploads publics.
# Ne pas mettre un profil CMYK arbitraire : choix approuvé pour la presse/imprimeur.
PDFX_ENABLED=false
PDFX_GS_BIN=/usr/bin/gs
PDFX_TIMEOUT_BIN=/usr/bin/timeout
PDFX_ICC_PROFILE=
PDFX_OUTPUT_CONDITION="Custom CMYK - confirm with printer"
PDFX_MAX_BYTES=26214400
